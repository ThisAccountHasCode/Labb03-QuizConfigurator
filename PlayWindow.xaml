<Window x:Class="Labb03___Quiz_Configurator.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play Quiz"
        Height="400"
        Width="600">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding QuestionProgress}"/>
        <TextBlock Text="{Binding RemainingTimeSeconds, StringFormat='Time remaining: {0} seconds'}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTimeRunningLow}"
                                     Value="True">
                            <Setter Property="Foreground"
                                    Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding CurrentQuestion.Text}"
                   FontSize="20"/>
        <ListBox ItemsSource="{Binding CurrentAnswers}"
                 SelectedItem="{Binding SelectedAnswer}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Text}"/>
                        <Image Source="/Assets/correct.png"
                               Width="16"
                               Height="16"
                               Margin="8,0,0,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCorrect}"
                                                           Value="True"/>
                                                <Condition Binding="{Binding DataContext.HasAnswered, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Submit Answer"
                Command="{Binding SubmitAnswerCommand}"/>
        <TextBlock Text="{Binding Feedback}"/>
        <Image Width="48"
               Height="48">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AnswerWasCorrect}"
                                     Value="True">
                            <Setter Property="Source"
                                    Value="/Assets/correct.png"/>
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <Image Width="48"
               Height="48">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AnswerWasCorrect}"
                                     Value="False">
                            <Setter Property="Source"
                                    Value="/Assets/incorrect.png"/>
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <Button Content="Continue / Result"
                Command="{Binding NextQuestionCommand}"/>
    </StackPanel>
</Window>
