<Window x:Class="Labb03___Quiz_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb03___Quiz_Configurator"
        mc:Ignorable="d"
        Title="Quiz Configurator"
        Height="450"
        Width="760">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Selected Pack Text -->
        <TextBlock Text="{Binding SelectedPack.Name, StringFormat='Selected Pack: {0}'}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="20,10,0,0"
                   FontSize="16"
                   Grid.Column="0"/>
        <!-- Quiz Pack List -->
        <ListBox ItemsSource="{Binding QuizPacks}"
                 SelectedItem="{Binding SelectedPack}"
                 DisplayMemberPath="Name"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="20,40,0,0"
                 Width="200"
                 Height="200"
                 Grid.Column="0"/>
        <!-- Add Question Button -->
        <Button Content="Add Question"
                Command="{Binding AddQuestionCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,245,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Add Pack Button -->
        <Button Content="Add Pack"
                Command="{Binding AddPackCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,275,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Delete Pack Button -->
        <Button Content="Delete Pack"
                Command="{Binding DeletePackCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,305,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Edit Pack Button -->
        <TextBox Text="{Binding SelectedPack.Name, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="20,335,0,0"
                 Width="90"
                 Height="20"
                 Grid.Column="0"/>
        <!-- Difficulty ComboBox -->
        <ComboBox ItemsSource="{Binding Difficulties}"
                  SelectedItem="{Binding SelectedPack.Difficulty, Mode=TwoWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="20,365,0,0"
                  Width="90"
                  Height="20"
                  Grid.Column="0"/>
        <!-- Selected Pack Text -->
        <TextBlock Text="{Binding SelectedPack.Name, StringFormat='Selected Pack: {0}'}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,0"
                   FontSize="24"
                   Grid.Column="1"/>
        <!-- Question List -->
        <ListBox ItemsSource="{Binding SelectedPack.Questions}"
                 SelectedItem="{Binding SelectedQuestion}"
                 DisplayMemberPath="Text"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,40,0,0"
                 Width="360"
                 Height="100"
                 Grid.Column="1"/>
        <!-- Answer List -->
        <ListBox ItemsSource="{Binding SelectedQuestion.Answers}"
                 DisplayMemberPath="Text"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,0,0,0"
                 Width="360"
                 Height="100"
                 Grid.Column="1"/>
    </Grid>
</Window>
