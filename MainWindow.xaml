<Window x:Class="Labb03___Quiz_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb03___Quiz_Configurator"
        mc:Ignorable="d"
        Title="Quiz Configurator"
        Height="450"
        Width="760">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Selected Pack Text -->
        <TextBlock Text="{Binding SelectedPack.Name, StringFormat='Selected Pack: {0}'}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="20,10,0,0"
                   FontSize="16"
                   Grid.Column="0"/>
        <!-- Quiz Pack List -->
        <ListBox ItemsSource="{Binding QuizPacks}"
                 SelectedItem="{Binding SelectedPack}"
                 DisplayMemberPath="Name"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="20,40,0,0"
                 Width="200"
                 Height="200"
                 Grid.Column="0"/>
        <!-- Add Question Button -->
        <Button Content="Add Question"
                Command="{Binding AddQuestionCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,245,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Add Pack Button -->
        <Button Content="Add Pack"
                Command="{Binding AddPackCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,275,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Delete Pack Button -->
        <Button Content="Delete Pack"
                Command="{Binding DeletePackCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,305,0,0"
                Width="90"
                Height="20"
                Grid.Column="0"/>
        <!-- Edit Pack Button -->
        <TextBox Text="{Binding SelectedPack.Name, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="20,335,0,0"
                 Width="90"
                 Height="20"
                 Grid.Column="0"/>
        <!-- Difficulty ComboBox -->
        <ComboBox ItemsSource="{Binding Difficulties}"
                  SelectedItem="{Binding SelectedPack.Difficulty, Mode=TwoWay}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="20,365,0,0"
                  Width="90"
                  Height="20"
                  Grid.Column="0"/>
        <!-- Selected Pack Text -->
        <TextBlock Text="{Binding SelectedPack.Name, StringFormat='Selected Pack: {0}'}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,0"
                   FontSize="24"
                   Grid.Column="1"/>
        <!-- Question List -->
        <ListBox ItemsSource="{Binding SelectedPack.Questions}"
                 SelectedItem="{Binding SelectedQuestion}"
                 DisplayMemberPath="Text"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,40,0,0"
                 Width="360"
                 Height="100"
                 Grid.Column="1"/>
        <!-- Question Text -->
        <TextBox Text="{Binding SelectedQuestion.Text, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Width="360"
                 Height="30"
                 Margin="0,145,0,0"
                 Grid.Column="1"/>
        <!-- Answer List -->
        <ListBox ItemsSource="{Binding SelectedQuestion.Answers}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,185,0,0"
                 Width="360"
                 Height="100"
                 Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Width="340"
                             Height="20">
                    </TextBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Time Limit Text -->
        <TextBox Text="{Binding SelectedPack.TimeLimitSeconds, UpdateSourceTrigger=PropertyChanged}"
                 x:Name="TimeLimitTextBox"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,40"
                 FontSize="16"
                 Grid.Column="1"/>
        <!-- Time Limit NOT > (int)0 && NOT Valid time -->
        <TextBlock Text="Enter a whole number greater than 0 for the time limit in seconds."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,15"
                   Grid.Column="1">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TimeLimitTextBox, Path=(Validation.HasError)}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPack.HasValidTimeLimit}"
                                     Value="False">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
