<Window x:Class="Labb03___Quiz_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb03___Quiz_Configurator"
        mc:Ignorable="d"
        Title="Quiz Configurator"
        Height="568"
        Width="800">
    <Window.InputBindings>
        <KeyBinding Key="A"
                    Modifiers="Control+Shift"
                    Command="{Binding AddPackCommand}"/>
        <KeyBinding Key="P"
                    Modifiers="Control+Shift"
                    Command="{Binding DeletePackCommand}"/>
        <KeyBinding Key="N"
                    Modifiers="Control+Shift"
                    Command="{Binding AddQuestionCommand}"/>
        <KeyBinding Key="D"
                    Modifiers="Control+Shift"
                    Command="{Binding DeleteQuestionCommand}"/>
        <KeyBinding Key="O"
                    Modifiers="Control+Shift"
                    Command="{Binding TogglePackOptionsCommand}"/>
        <KeyBinding Key="S"
                    Modifiers="Control+Shift"
                    Command="{Binding SavePackCommand}"/>
        <KeyBinding Key="E"
                    Modifiers="Control+Shift"
                    Command="{Binding OpenPackCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <!--  Pack menu sub-menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Quiz _Pack">
                <MenuItem Header="Op_en Pack"
                          Command="{Binding OpenPackCommand}"
                          InputGestureText="Ctrl+Shift+E"/>
                <MenuItem Header="Pack _Options"
                          Command="{Binding TogglePackOptionsCommand}"
                          InputGestureText="Ctrl+Shift+O"/>
                <MenuItem Header="_Add Pack"
                          Command="{Binding AddPackCommand}"
                          InputGestureText="Ctrl+Shift+A"/>
                <MenuItem Header="_Delete Pack"
                          Command="{Binding DeletePackCommand}"
                          InputGestureText="Ctrl+Shift+P"/>
                <MenuItem Header="_Save Pack"
                          Command="{Binding SavePackCommand}"
                          InputGestureText="Ctrl+Shift+S"/>
            </MenuItem>
            <!--  Question menu sub-menu -->
            <MenuItem Header="_Question">
                <MenuItem Header="_Add Question"
                          Command="{Binding AddQuestionCommand}"
                          InputGestureText="Ctrl+Shift+N"/>
                <MenuItem Header="_Delete Question"
                          Command="{Binding DeleteQuestionCommand}"
                          InputGestureText="Ctrl+Shift+D"/>
            </MenuItem>
            <MenuItem Header="_Load trivia categories"
                      Command="{Binding ImportTriviaCategoriesCommand}"/>
            <MenuItem Header="_Import trivia questions"
                      Command="{Binding ImportTriviaQuestionsCommand}"/>
        </Menu>
        <Grid Height="500"
              Width="780">
            <Grid.RowDefinitions>
                <RowDefinition Height="229*"/>
                <RowDefinition Height="316*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--  Trivia categories combo box -->
            <ComboBox ItemsSource="{Binding TriviaCategories}"
                      SelectedItem="{Binding SelectedTriviaCategory, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Grid.Column="0"
                      Grid.Row="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="30,208,0,0"
                      Width="180"/>
            <!-- Import Question Count Selection box -->
            <ComboBox ItemsSource="{Binding TriviaQuestionCounts}"
                      SelectedItem="{Binding TriviaQuestionCount, Mode=TwoWay}"
                      ToolTip="Number of questions to import"
                      Grid.Column="0"
                      Grid.Row="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="30,235,0,0"
                      Width="180"/>
            <!-- Import questions difficulty selection box -->
            <ComboBox ItemsSource="{Binding Difficulties}"
                      SelectedItem="{Binding TriviaDifficulty, Mode=TwoWay}"
                      ToolTip="Difficulty of imported questions"
                      Grid.Column="0"
                      Grid.Row="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="30,262,0,0"
                      Width="180"/>
            <!-- Start game button -->
            <Button Content="Play"
                    Command="{Binding StartGameCommand}"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,220,0,0"
                    Width="120"
                    Grid.Row="1"/>
            <!-- Selected Pack Text -->
            <TextBlock Text="Select a pack:"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="60,10,0,0"
                       FontSize="16"
                       Grid.Column="0"/>
            <!-- Quiz Pack List -->
            <ListBox ItemsSource="{Binding QuizPacks}"
                     SelectedItem="{Binding SelectedPack}"
                     DisplayMemberPath="Name"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="35,40,0,0"
                     Width="170"
                     Height="200"
                     Grid.Column="0"
                     Grid.RowSpan="2"/>
            <!-- Questions management UI -->
            <Grid Grid.Column="1"
                  Width="360"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,115,0,0"
                  Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Add Question Button -->
                <Button Content="Add Question"
                        Command="{Binding AddQuestionCommand}"
                        Grid.Column="0"
                        Margin="0,0,10,0"/>
                <!-- Delete Question Button -->
                <Button Content="Delete Question"
                        Command="{Binding DeleteQuestionCommand}"
                        Grid.Column="1"
                        Margin="5,0"/>
                <!-- Set Correct Answer Button -->
                <Button Content="Set Correct Answer"
                        Command="{Binding SetCorrectAnswerCommand}"
                        Grid.Column="2"
                        Margin="10,0,0,0"/>
            </Grid>
            <!-- Add Pack Button -->
            <Button Content="Add Pack"
                    Command="{Binding AddPackCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="75,39,0,0"
                    Width="90"
                    Height="20"
                    Grid.Column="0"
                    Grid.Row="1"/>
            <!-- Delete Pack Button -->
            <Button Content="Delete Pack"
                    Command="{Binding DeletePackCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="75,64,0,0"
                    Width="90"
                    Height="20"
                    Grid.Column="0"
                    Grid.Row="1"/>
            <!-- Pack Options Expander -->
            <Expander Header="Pack Options"
                      IsExpanded="{Binding IsPackOptionsOpen, Mode=TwoWay}"
                      Grid.Column="0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="65,89,0,0"
                      Height="106"
                      Grid.Row="1">
                <StackPanel>
                    <!-- Edit Pack Button -->
                    <TextBox Text="{Binding SelectedPack.Name, UpdateSourceTrigger=PropertyChanged}"
                             Width="90"
                             Height="20"/>
                    <!-- Difficulty ComboBox -->
                    <ComboBox ItemsSource="{Binding Difficulties}"
                              SelectedItem="{Binding SelectedPack.Difficulty, Mode=TwoWay}"
                              Width="90"
                              Height="20"/>
                    <!-- Time Limit Text -->
                    <TextBlock Text="Time limit (seconds):"/>
                    <TextBox Text="{Binding SelectedPack.TimeLimitSeconds, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="TimeLimitTextBox"
                             FontSize="16"
                             Width="90"/>
                    <!-- Time Limit NOT > (int)0 && NOT Valid time -->
                    <TextBlock Text="Enter a whole number greater than 0 for the time limit in seconds."
                               Width="180"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TimeLimitTextBox, Path=(Validation.HasError)}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedPack.HasValidTimeLimit}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander>
            <!-- Selected Pack Text -->
            <TextBlock Text="{Binding SelectedPack.Name, StringFormat='Selected Pack: {0}'}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="24"
                       Grid.Column="1"/>
            <!-- Question List Box -->
            <ListBox ItemsSource="{Binding SelectedPack.Questions}"
                     SelectedItem="{Binding SelectedQuestion}"
                     DisplayMemberPath="Text"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Grid.Column="1"
                     Width="360"
                     Height="170"
                     Margin="0,40,0,0"
                     Grid.RowSpan="2"/>
            <!-- Edit Question Text -->
            <TextBlock Text="Edit selected question:"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,139,0,0"
                       Grid.Row="1"/>
            <!-- Question Text -->
            <TextBox Text="{Binding SelectedQuestion.Text, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Width="360"
                     Height="30"
                     Margin="0,160,0,0"
                     Grid.Column="1"
                     Grid.Row="1"/>
            <!-- Answer List -->
            <ListBox ItemsSource="{Binding SelectedQuestion.Answers}"
                     SelectedItem="{Binding SelectedAnswer}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,4,0,0"
                     Width="360"
                     Height="103"
                     Grid.Column="1"
                     Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     Width="230"
                                     Height="20"
                                     Margin="8,0,0,0">
                            </TextBox>
                            <TextBlock Text="✓"
                                       Foreground="Green"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCorrect}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Required"
                                       Foreground="Red">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnswerText}"
                                                         Value="false">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Duplicate validation message -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,195,0,0"
                        Grid.Row="1">
                <TextBlock Text="Must be 4 unique answers"
                           TextAlignment="Center"
                           Foreground="Red">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedQuestion.HasDuplicateAnswers}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- One Correct answer exist validation message -->
                <TextBlock Text="One answer must be marked correct"
                           TextAlignment="Center"
                           Foreground="Red">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedQuestion.HasOneCorrectAnswer}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Complete validation message -->
                <TextBlock Text="Question is correctly configured!"
                           TextAlignment="Center"
                           Foreground="Green">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedQuestion.IsValid}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Question text validation message -->
                <TextBlock Text="Enter a question:"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedQuestion.HasQuestionText}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
