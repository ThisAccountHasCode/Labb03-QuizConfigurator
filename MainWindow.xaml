<Window x:Class="Labb03___Quiz_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb03___Quiz_Configurator"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450"
        Width="800">
    <Grid>
        <Button Content="Change title"
                Command="{Binding ChangeTitleCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="120"
                Height="40"/>
        <TextBlock Text="{Binding CurrentPack.Name}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   FontSize="24"/>
        <ListBox ItemsSource="{Binding CurrentPack.Questions}"
                 SelectedItem="{Binding SelectedQuestion}"
                 DisplayMemberPath="Text"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="400"
                 Height="200"/>
        <ListBox ItemsSource="{Binding SelectedQuestion.Answers}"
                 DisplayMemberPath="Text"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,20"
                 Width="400"
                 Height="100"/>
    </Grid>
</Window>
